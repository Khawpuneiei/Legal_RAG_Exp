# Copy to .env if you change defaults. No real keys belong in this repo.
# Local LLM used for contextual retrieval (R5), query rewriting (R4q) and the generation/grounding eval.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
